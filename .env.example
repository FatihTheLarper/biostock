# =============================================================================
# BioStock Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# Never commit your real `.env.local`. It is gitignored.

# -----------------------------------------------------------------------------
# TheMealDB API
# Used for fetching the global ingredient list and generating recipes.
# Free tier uses demo key "1" with the public endpoint; replace with your own
# key if you have one.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
NEXT_PUBLIC_THEMEALDB_API_KEY=1

# -----------------------------------------------------------------------------
# MongoDB (database connection string)
# Used to persist the user's saved ingredients and generated recipes.
# With Atlas, build your connection string from the cluster dashboard.
# Keep your password out of any committed file.
#
# Using mongoose, the app connects to the default database named in the
# connection string (for Atlas this defaults to the `test` database unless you
# specify one). Mongoose pluralizes each model name into a collection on first
# use:
#   - `savingredients`  (from the SavedIngredient model)
#   - `savedrecipes`    (from the SavedRecipe model)
#
# You do NOT need to create collections or databases by hand; mongoose does it
# for you. If you prefer a named database, append it to the path,
# e.g. `...mongodb.net/biostock`.
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Clerk (authentication)
# Create an application at https://dashboard.clerk.com and grab these keys
# from the API Keys section. The publishable key is public and starts with
# `pk_test_` / `pk_live_`; the secret key is private and starts with
# `sk_test_` / `sk_live_`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_<test_or_live>_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_<test_or_live>_xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Clerk routing
# Tells Clerk which routes to use for sign-in and sign-up.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Optional
# Disables Clerk telemetry.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
